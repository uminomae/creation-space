#!/bin/sh
set -eu

if [ "${SKIP_DEV_VERSION_BUMP:-0}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node is required to bump src/version.js" >&2
  exit 1
fi

node "$repo_root/scripts/bump-dev-version.mjs" >/dev/null
git -C "$repo_root" add src/version.js
